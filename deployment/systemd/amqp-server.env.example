# Optional environment overrides for amqp-server.
# Installed as /etc/amqp/amqp-server.env; the unit's EnvironmentFile uses a
# leading "-", so the file may be absent. Format: AMQP_<SECTION>_<KEY>=value.
# Precedence: defaults < config file < environment < explicit CLI flags.

#AMQP_SERVER_LOGLEVEL=debug
#AMQP_NETWORK_ADDRESS=10.0.0.5:5672
#AMQP_TELEMETRY_ADDRESS=127.0.0.1
#AMQP_SECURITY_AUTHENTICATIONENABLED=true
