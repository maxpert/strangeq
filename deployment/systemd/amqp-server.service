[Unit]
Description=StrangeQ AMQP 0.9.1 Message Broker
Documentation=https://github.com/maxpert/strangeq
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=amqp
Group=amqp
WorkingDirectory=/var/lib/amqp
EnvironmentFile=-/etc/amqp/amqp-server.env
ExecStart=/usr/local/bin/amqp-server --config /etc/amqp/config.yaml --enable-telemetry
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
LimitNOFILE=65536
LimitNPROC=4096
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/amqp
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=45
StandardOutput=journal
StandardError=journal
SyslogIdentifier=amqp-server

[Install]
WantedBy=multi-user.target
